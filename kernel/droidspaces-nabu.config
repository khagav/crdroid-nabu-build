# droidspaces-nabu.config
# Kernel config fragment that makes the crDroid nabu kernel (Linux 4.14) usable
# as a Droidspaces host.
#
# Source of the option list: ravindu644/Droidspaces-OSS
#   Documentation/Kernel-Configuration.md  -> "Non-GKI kernels (3.18 to 4.19)"
#   (fetched 2026-10-22)
#
# Merged at build time with scripts/kconfig/merge_config.sh, so unknown symbols
# are ignored with a warning instead of breaking the build. Symbols marked
# [4.19+] do not exist in 4.14 and are expected to be skipped.
#
# Why this file exists: the stock crDroid 17.0 defconfig has
#   # CONFIG_PID_NS is not set
# and PID_NS is exactly what a container runtime cannot work without.

# ---------- IPC mechanisms ----------
CONFIG_SYSCTL=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y

# ---------- core namespaces (the blocker) ----------
CONFIG_NAMESPACES=y
CONFIG_PID_NS=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y

# ---------- seccomp ----------
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# ---------- cgroups ----------
CONFIG_CGROUPS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_NET_PRIO=y
CONFIG_MEMCG=y
CONFIG_MEMCG_SWAP=y
CONFIG_MEMCG_SWAP_ENABLED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_CPUACCT=y

# ---------- filesystems ----------
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y

# ---------- firmware loading inside containers ----------
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_USER_HELPER=y
CONFIG_FW_LOADER_COMPRESS=y

# ---------- networking: namespaces, bridge, veth ----------
CONFIG_NET_NS=y
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_TUN=y
CONFIG_MACVLAN=y

# ---------- netfilter / NAT ----------
CONFIG_NETFILTER=y
# 4.14 defconfig ships this explicitly OFF; NAT mode over a bridge needs it ON
CONFIG_BRIDGE_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_CONNTRACK_NETLINK=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_NF_NAT=y
CONFIG_NF_NAT_REDIRECT=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_TARGET_TCPMSS=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y

# legacy IPv4 NAT aliases (kept for old userland)
CONFIG_NF_CONNTRACK_IPV4=y
CONFIG_NF_NAT_IPV4=y

# nf_tables (used by modern iptables-nft inside containers)
CONFIG_NF_TABLES=y

# ---------- IPv6 / NAT66 (optional: without these NAT containers are v4 only) ----------
CONFIG_IPV6=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_MANGLE=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y
CONFIG_NF_CONNTRACK_IPV6=y
CONFIG_NF_NAT_IPV6=y

# ---------- Android quirk ----------
# Qualcomm defconfigs enable this; with it on, containers lose internet unless
# their gid is in AID_INET. Droidspaces docs say disable it on older kernels.
# CONFIG_ANDROID_PARANOID_NETWORK is not set
