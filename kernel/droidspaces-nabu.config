# droidspaces-nabu.config
# Kernel config fragment that makes the crDroid nabu kernel (Linux 4.14.357)
# usable as a Droidspaces / LXC host.
#
# Option list source: ravindu644/Droidspaces-OSS
#   Documentation/Kernel-Configuration.md -> "Non-GKI kernels (3.18 to 4.19)"
#
# Measured state of the kernel actually running on the device (2026-10-23,
# `zcat /proc/config.gz` on crDroid 17.0, 4.14.357-perf-ga17239b2eda3):
#
#   already on : NAMESPACES NET_NS UTS_NS CGROUPS MEMCG MEMCG_SWAP
#                SECCOMP SECCOMP_FILTER OVERLAY_FS TMPFS_XATTR VETH BRIDGE
#                NF_NAT NF_NAT_IPV4 NF_NAT_REDIRECT
#   missing    : PID_NS SYSVIPC POSIX_MQUEUE USER_NS DEVTMPFS CGROUP_PIDS
#                MACVLAN BRIDGE_NETFILTER NF_TABLES
#
# The missing set is what this file adds. Already-set options are repeated on
# purpose: merge_config.sh is idempotent and the repetition documents intent.
#
# ABI WARNING - read before changing this file
# --------------------------------------------
# CONFIG_SYSVIPC inserts `struct sysv_sem sysvsem` / `struct sysv_shm sysvshm`
# into struct task_struct directly AFTER `char comm[]`. Every field that
# follows (fs, files, cred, signal, sighand, nsproxy, thread, ...) therefore
# moves, which breaks any out-of-tree module compiled against the old layout.
# Checked on this device: /vendor/lib/modules holds exactly one real module
# (msm-geni-ir.ko, a serial IR driver) and `lsmod` is empty - the kernel is
# effectively monolithic, so the ABI shift is harmless here. If a future ROM
# ships more vendor modules, they must be rebuilt with the same .config.

# ---------- IPC mechanisms ----------
CONFIG_SYSCTL=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y

# ---------- core namespaces (the actual blocker) ----------
CONFIG_NAMESPACES=y
CONFIG_PID_NS=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y

# ---------- seccomp ----------
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# ---------- cgroups ----------
CONFIG_CGROUPS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_NET_PRIO=y
CONFIG_MEMCG=y
CONFIG_MEMCG_SWAP=y
CONFIG_MEMCG_SWAP_ENABLED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_CPUACCT=y

# ---------- filesystems ----------
CONFIG_DEVTMPFS=y
# Deliberately NOT set: DEVTMPFS_MOUNT makes the kernel mount devtmpfs over
# /dev during boot. Android's init owns /dev (tmpfs + ueventd) and Droidspaces
# mounts devtmpfs inside the container itself, so auto-mounting buys nothing
# and risks fighting init.
# CONFIG_DEVTMPFS_MOUNT is not set
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y

# ---------- firmware loading inside containers ----------
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_USER_HELPER=y
CONFIG_FW_LOADER_COMPRESS=y

# ---------- networking: namespaces, bridge, veth ----------
CONFIG_NET_NS=y
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_TUN=y
CONFIG_MACVLAN=y

# ---------- netfilter / NAT ----------
CONFIG_NETFILTER=y
# 4.14 defconfig ships this explicitly OFF; NAT over a bridge needs it ON
CONFIG_BRIDGE_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_CONNTRACK_NETLINK=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_NF_NAT=y
CONFIG_NF_NAT_REDIRECT=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_TARGET_TCPMSS=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y

# legacy IPv4 NAT aliases (kept for old userland)
CONFIG_NF_CONNTRACK_IPV4=y
CONFIG_NF_NAT_IPV4=y

# nf_tables (used by iptables-nft inside containers)
CONFIG_NF_TABLES=y

# ---------- IPv6 / NAT66 ----------
CONFIG_IPV6=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_MANGLE=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y
CONFIG_NF_CONNTRACK_IPV6=y
CONFIG_NF_NAT_IPV6=y
